#!/usr/bin/env python3
"""Run sshCryptoChecker straight from a git checkout, without installing it.

    ./ssh-crypto-checker server.example.com

Installed users get the same command from ``pip install .``; this wrapper only
exists so the repository can be cloned onto a jump host and used immediately.
"""

from __future__ import annotations

import sys
from pathlib import Path

if __package__ in (None, ""):
    sys.path.insert(0, str(Path(__file__).resolve().parent))

from ssh_crypto_checker.cli import main  # noqa: E402  (import after sys.path fix)

if __name__ == "__main__":
    sys.exit(main())
